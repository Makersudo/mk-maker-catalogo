{
  "name": "mk-maker-catalogo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend && npm run lint --workspace mobile",
    "dev:mobile": "npm run start --workspace mobile",
    "android": "npm run android --workspace mobile",
    "start:backend": "npm run start --workspace backend",
    "client:apply": "npm run client:apply --workspace backend --"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
